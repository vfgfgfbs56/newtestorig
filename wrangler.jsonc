{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "newtestorig",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-06",
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ]
}
